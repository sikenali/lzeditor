{
  "name": "lzeditor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx vite\" \"npx tsx watch server/src/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server:start": "tsx server/src/index.ts",
    "electron:dev": "concurrently \"npm run dev:web\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && electron-builder",
    "electron:build:mac": "npm run build && tsc -p electron/tsconfig.json && electron-builder --mac",
    "electron:build:win": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:linux": "npm run build && tsc -p electron/tsconfig.json && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@hpcc-js/wasm": "^2.35.2",
    "@markdown-viewer/draw-uml": "^1.4.8",
    "@markdown-viewer/drawio2svg": "^1.5.5",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dompurify": "^3.4.15",
    "dotenv": "^16.4.5",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^4.21.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "mermaid": "^12.0.0",
    "openai": "^4.52.0",
    "plantuml-encoder": "^1.4.0",
    "prettier": "^3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remixicon-react": "^1.0.0",
    "viz.js": "^2.1.2",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.lzeditor.app",
    "productName": "lzeditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.png",
      "hardenedRuntime": true,
      "entitlements": null,
      "entitlementsInherit": null,
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-${os}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "lzeditor",
      "installerIcon": "public/icon.png",
      "uninstallerIcon": "public/icon.png",
      "artifactName": "${productName}-${version}-${os}-setup.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libsndfile1",
        "libwl-rocket-4-10",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {
    "better-sqlite3@9.6.0": true
  }
}

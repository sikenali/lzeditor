{
  "name": "lzeditor",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "concurrently npm:dev:web npm:dev:server",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "npm run build && node --import tsx --test tests/e2e/e2e.test.mjs tests/e2e/editor-interactions.spec.ts tests/e2e/milkdown-smoke.test.mjs tests/e2e/ui-surface.spec.ts",
    "e2e:run": "node --test tests/e2e/e2e.test.mjs",
    "server:start": "tsx server/src/index.ts",
    "electron:dev": "concurrently \"npm run dev:web\" \"npm run dev:server\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && electron-builder",
    "electron:build:mac": "npm run build && tsc -p electron/tsconfig.json && electron-builder --mac",
    "electron:build:win": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:linux": "npm run build && tsc -p electron/tsconfig.json && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@types/mdast": "^4.0.4",
    "decode-named-character-reference": "^1.3.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "emoji-picker-react": "^4.22.2",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "isomorphic-git": "^1.44.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.1",
    "mermaid": "^11.17.2",
    "micromark-util-chunked": "^2.0.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "micromark-util-types": "^2.0.0",
    "prettier": "^3.9.8",
    "prosemirror-highlight": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "refractor": "^5.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "remixicon": "^3.5.0",
    "tiny-pinyin": "1.3.2",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lzeditor.app",
    "productName": "lzeditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.png",
      "hardenedRuntime": true,
      "entitlements": null,
      "entitlementsInherit": null,
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "${productName}-${version}-${os}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libsndfile1",
        "libwl-rocket-4-10",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {},
  "main": "electron/main.js",
  "author": {
    "name": "sikenali",
    "email": "mrchiang1015@aliyun.com"
  }
}

{
  "name": "lzeditor",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "dev": "concurrently npm:dev:web npm:dev:server",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "npm run build && node --test tests/e2e/e2e.test.mjs",
    "e2e:run": "node --test tests/e2e/e2e.test.mjs",
    "server:start": "tsx server/src/index.ts",
    "electron:dev": "concurrently \"npm run dev:web\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && electron-builder",
    "electron:build:mac": "npm run build && tsc -p electron/tsconfig.json && electron-builder --mac",
    "electron:build:win": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:linux": "npm run build && tsc -p electron/tsconfig.json && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "emoji-picker-react": "^4.22.2",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remixicon": "^3.5.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lzeditor.app",
    "productName": "lzeditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.png",
      "hardenedRuntime": true,
      "entitlements": null,
      "entitlementsInherit": null,
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-${os}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "lzeditor",
      "installerIcon": "public/icon.png",
      "uninstallerIcon": "public/icon.png",
      "artifactName": "${productName}-${version}-${os}-setup.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libsndfile1",
        "libwl-rocket-4-10",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {},
  "main": "electron/main.js",
  "author": {
    "name": "sikenali",
    "email": "mrchiang1015@aliyun.com"
  }
}
